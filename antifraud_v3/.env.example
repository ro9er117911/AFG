# LLM provider (see llm/__init__.py factory)
#   claude_code (default) — shells out to the `claude` CLI (Claude Code). Billed against a
#     Claude Pro/Max subscription, not a metered API key — run `claude auth status` to check
#     you're logged in (authMethod: "claude.ai"). Needs the `claude` CLI installed and on
#     PATH. See llm/claude_code_provider.py.
#   claude — direct anthropic SDK calls, needs ANTHROPIC_API_KEY below (or `ant auth login`).
#     Only worth using if you have a funded API key — otherwise every call costs real money.
LLM_PROVIDER=claude_code
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Only read when LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=

# Local audio-native detectors (detectors/, config.py) — deployment-level, read once at import
# time, unlike the above (which storage/settings_store.py can hot-reload from the Settings
# screen). Defaults shown are what this project verified working on an RTX 3080 Ti (12GB).
# DEEPFAKE_MODEL_ID=nii-yamagishilab/xls-r-2b-anti-deepfake
# DEEPFAKE_DTYPE=float16
# DEEPFAKE_FAKE_SCORE_THRESHOLD=0.85
# SCAM_SEMANTIC_MODEL_ID=JimmyMa99/AntiFraud-SFT
# SCAM_SEMANTIC_LOAD_IN_4BIT=true
# SCAM_SEMANTIC_MAX_AUDIO_SECONDS=30
# SCAM_SEMANTIC_MAX_NEW_TOKENS=512
