# LLM provider (see llm/__init__.py factory)
#   claude_code (default) — shells out to the `claude` CLI (Claude Code). Billed against a
#     Claude Pro/Max subscription, not a metered API key — run `claude auth status` to check
#     you're logged in (authMethod: "claude.ai"). Needs the `claude` CLI installed and on
#     PATH. See llm/claude_code_provider.py.
#   claude — direct anthropic SDK calls, needs ANTHROPIC_API_KEY below (or `ant auth login`).
#     Only worth using if you have a funded API key — otherwise every call costs real money.
LLM_PROVIDER=claude_code
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Only read when LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=
