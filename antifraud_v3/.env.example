# LLM provider (see llm/__init__.py factory)
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Claude auth — resolved automatically by the anthropic SDK from either of:
#   1. ANTHROPIC_API_KEY below, or
#   2. `ant auth login` (no env var needed if you use this)
ANTHROPIC_API_KEY=

# Alert tuning (see pipeline/call_state.py)
DEBOUNCE_CHUNKS=2
